# 80085 local development. Copy to .env; never commit .env.
DATABASE_URL=postgresql+asyncpg://boobs:boobs@localhost:55432/boobs
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=boobs
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1

# Registry used by scripts/build_capabilities.py for example artifacts.
ARTIFACT_REGISTRY=localhost:5000

# Sandbox policy defaults (spec section 15). Overridable per experience policy.
SANDBOX_CPU=2
SANDBOX_MEMORY_MB=2048
SANDBOX_TMPFS_MB=4096
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_PIDS=128
SANDBOX_MAX_OUTPUT_BYTES=1048576

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO

# Bootstrap key for scripts/seed.py only. Rotate before any real use.
BOOBS_BOOTSTRAP_TOKEN=dev-bootstrap-change-me
