# 80085 local development. Copy to .env; never commit .env.
# The execution queue lives in Postgres (see DECISIONS.md 17) -- no Redis.
DATABASE_URL=postgresql+asyncpg://boobs:boobs@localhost:55432/boobs

S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=boobs
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1

# Registry used by scripts/build_capabilities.py for example artifacts.
ARTIFACT_REGISTRY=localhost:5000

# Sandbox policy defaults (spec section 15). Overridable per experience policy.
SANDBOX_CPU=2
SANDBOX_MEMORY_MB=2048
SANDBOX_TMPFS_MB=4096
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_PIDS=128
SANDBOX_MAX_OUTPUT_BYTES=1048576

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO

# Bootstrap key for scripts/seed.py only. Rotate before any real use.
BOOBS_BOOTSTRAP_TOKEN=dev-bootstrap-change-me

# Worker (runs wherever Docker is; talks to the API over HTTPS only)
BOOBS_API_URL=http://localhost:8000
BOOBS_API_KEY=
BOOBS_WORKER_ID=

# BOOBS_RUNTIME (docker|e2b), E2B_API_KEY and BOOBS_EXEC_CACHE are read from
# the process environment, not from this file -- like BOOBS_EMBEDDER. Export
# them. See AGENTS.md and DECISIONS.md 19-20. Never commit an E2B key.
#
# BOOBS_REGISTRY_USERNAME / BOOBS_REGISTRY_PASSWORD authenticate the pull of a
# private artifact. E2B builds the template on its own machines, so without
# these a private image fails inside its builder where nobody can see it.
# Set both or neither. Not needed for a public registry.
