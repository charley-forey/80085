# Everything build.mjs writes. Vercel runs the build; committing the output
# would let it drift from content.js, which is the one thing this site's
# architecture exists to prevent.
/index.html
/install.html
/key.html
/1337.html
/404.html
/small.js
/public/index.*
/public/install.*
/public/llms.txt
/public/llms-full.txt
/public/agents.md
/public/robots.txt
/public/sitemap.xml
/public/boot.js
/public/og.svg
/public/.well-known/

# Committed, not generated:
#   og.png    drawn by scripts/make-og.py; there is no rasteriser in the build
#   icon.svg  a copy of the root brand icon, so this directory is a complete
#             deployable root on its own and the build never reaches outside it

.vercel
